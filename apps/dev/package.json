{
  "name": "@app/dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf ./dist",
    "build:tsc": "tsc -p ./tsconfig.json && tsc-alias",
    "build:rspack": "npm run clean && NODE_ENV=production rspack build --mode production",
    "build:rsbuild": "npm run clean && NODE_ENV=production rsbuild build",
    "build": "npm run build:rspack",
    "dev:rspack": "rspack serve",
    "dev:rsbuild": "rsbuild dev --open",
    "dev": "npm run dev:rspack",
    "preview:rsbuild": "rsbuild preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tools/eslint-config": "*",
    "@tools/module-federation-config": "*",
    "@tools/rspack-config": "*",
    "@tools/rsbuild-config": "*",
    "@tools/semantic-release-config": "*",
    "@tools/typescript-config": "*",
    "@types/node": "^20",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1"
  }
}
