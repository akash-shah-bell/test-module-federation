{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["FEDERATION_DEBUG"],
  "tasks": {
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "build": {
      "cache": false,
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "build:rsbuild": {
      "cache": false,
      "dependsOn": ["^build:rsbuild"]
    },
    "build:rspack": {
      "cache": false,
      "dependsOn": ["^build:rspack"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:rsbuild": {
      "cache": false,
      "persistent": true
    },
    "dev:rspack": {
      "cache": false,
      "persistent": true,
      "env": ["FEDERATION_DEBUG"]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", "tests/**/*"],
      "outputs": []
    }
  }
}
