{
  "name": "@explat-mfe/green-template",
  "description": "MFE template",
  "version": "0.0.0-semantically-released",
  "main": "./dist/index.js",
  "types": "./dist/_types/index.d.ts",
  "style": "./dist/style.css",
  "scripts": {
    "build:rspack": "NODE_ENV=production rspack build --mode production",
    "build": "npm run build:rspack",
    "dev:rspack": "rspack serve",
    "dev": "tsc && npm run dev:rspack",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "jest",
    "test:unit": "jest --ci --testResultsProcessor='jest-junit'",
    "clean:cache": "npm cache clean --force",
    "release": "semantic-release"
  },
  "peerDependencies": {
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@module-federation/enhanced": "0.13.1",
    "@pmmmwh/react-refresh-webpack-plugin": "0.6.0",
    "@rspack/cli": "1.3.10",
    "@rspack/core": "1.3.10",
    "@rspack/dev-server": "1.1.1",
    "@tools/eslint-config": "*",
    "@tools/typescript-config": "*",
    "@tools/webpack-config": "*",
    "@semantic-release/gitlab": "~13.2.3",
    "@types/node": "^20.11.23",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "conventional-changelog-conventionalcommits": "~8.0.0",
    "react-refresh": "0.17.0",
    "semantic-release": "~24.2.1"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/gitlab"
    ]
  }
}