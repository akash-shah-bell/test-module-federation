{
  "compileOnSave": false,
  // "extends": "@tools/typescript-config/react.tsconfig.json", // does not work with module federation
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,

    // declaration emission
    "noEmit": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": false,
    "declaration": true,

    // output
    "outDir": "./dist",
    "baseUrl": ".",
    "rootDir": "./",
    "paths": {
      "@/*": ["./src/*"],
      "*": [
        "./@mf-types/*",
        "./dist/@mf-types/*"
      ]
    }
  },
  "include": [
    "./@mf-types/*",
    "./src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "public",
    ".vscode",
    ".storybook",
    ".git",
    ".idea",
    ".vscode"
  ]
}
