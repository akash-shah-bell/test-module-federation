{
  "name": "@package/mfe1",
  "description": "MFE template",
  "version": "0.0.0-semantically-released",
  "main": "./dist/index.js",
  "types": "./dist/@mf-types/index.d.ts",
  "style": "./dist/style.css",
  "scripts": {
    "clean": "rm -rf ./dist",
    "build:tsc": "tsc -p ./tsconfig.json && tsc-alias",
    "build:rspack": "npm run clean && NODE_ENV=production rspack build --mode production",
    "build:rsbuild": "npm run clean && NODE_ENV=production rsbuild build",
    "build": "npm run build:rspack",
    "dev:rspack": "FEDERATION_DEBUG=true rspack serve",
    "dev:rsbuild": "rsbuild dev --open",
    "dev": "npm run dev:rspack",
    "preview:rsbuild": "rsbuild preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "jest",
    "test:unit": "jest --ci --testResultsProcessor='jest-junit'",
    "clean:cache": "npm cache clean --force",
    "release": "semantic-release"
  },
  "peerDependencies": {
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@tools/eslint-config": "*",
    "@tools/module-federation-config": "*",
    "@tools/rspack-config": "*",
    "@tools/rsbuild-config": "*",
    "@tools/semantic-release-config": "*",
    "@tools/typescript-config": "*",
    "@types/node": "^20.11.23",
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/gitlab"
    ]
  }
}