{
  "name": "@explat-mfe/blue-template",
  "description": "MFE template",
  "version": "0.0.0-semantically-released",
  "main": "./dist/index.js",
  "types": "./dist/_types/index.d.ts",
  "style": "./dist/style.css",
  "scripts": {
    "build:webpack": "webpack --mode development --env development=true --config=webpack-config/webpack.config.js",
    "build": "npm run build:webpack",
    "dev": "webpack-dev-server --mode development --env development=true --config=webpack-config/webpack.config.js --open",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "jest",
    "test:unit": "jest --ci --testResultsProcessor='jest-junit'",
    "clean:cache": "npm cache clean --force",
    "release": "semantic-release"
  },
  "peerDependencies": {
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@tools/eslint-config": "*",
    "@tools/typescript-config": "*",
    "@tools/webpack-config": "*",
    "@semantic-release/gitlab": "~13.2.3",
    "@types/node": "^20.11.23",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "axios": "^1.7.7",
    "conventional-changelog-conventionalcommits": "~8.0.0",
    "semantic-release": "~24.2.1"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/gitlab"
    ]
  }
}