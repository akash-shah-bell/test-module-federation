{
  "compilerOptions": {
    "lib": [
      "es2021",
      "dom"
    ],
    "types": [
      "node",
      "jest"
    ],
    "target": "es6",
    "module": "nodenext",
    "allowJs": true,
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "index.ts"
  ],
  "exclude": [
    "integration-test/**/*",
    "unit-test/**/*",
    "dist",
    "node_modules",
    ".vscode",
    "lib"
  ]
}
